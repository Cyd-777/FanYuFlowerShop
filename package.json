{
  "name": "fan-yu-flower-shop",
  "version": "0.1.4",
  "private": true,
  "description": "梵宇花店小程序",
  "templateInfo": {
    "name": "vue3-NutUI",
    "typescript": true,
    "css": "less",
    "framework": "Vue3"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "prebuild:weapp": "node scripts/generate-tab-icons.js && node scripts/check-mp-vue-template.js",
    "postbuild:weapp": "node scripts/patch-dist-config.js && node scripts/prune-sub-common.js && node scripts/sync-tab-icons.js && node scripts/check-static-hoist.js && node scripts/check-mp-vue-template.js && node scripts/check-main-package.js",
    "generate:tab-icons": "node scripts/generate-tab-icons.js",
    "sync:cloud": "node scripts/sync-cloud-common.js",
    "deploy:cloud": "node scripts/deploy-cloud-functions.js",
    "push:cloud": "node scripts/push-cloud-functions.js",
    "sync:wiki-profiles": "node scripts/sync-wiki-profiles.js",
    "sync:wiki-rose-care": "node scripts/sync-wiki-rose-care.js",
    "sync:wiki-kind-care": "node scripts/sync-wiki-kind-care-blocks.js",
    "audit:wiki-rose-care": "node scripts/audit-wiki-rose-care-local.js",
    "audit:wiki-completeness": "node scripts/audit-wiki-completeness-local.js",
    "audit:wiki-catalog": "node scripts/audit-wiki-catalog-completeness-local.js",
    "generate:wiki-rose-l1": "node scripts/generate-wiki-rose-l1-overlays.js",
    "generate:wiki-rose-l2": "node scripts/generate-wiki-rose-l2-overlays.js",
    "generate:wiki-nonrose-l1": "node scripts/generate-wiki-nonrose-l1-overlays.js",
    "generate:wiki-nonrose-l2": "node scripts/generate-wiki-nonrose-l2-overlays.js",
    "generate:wiki-all-l2": "node scripts/generate-wiki-all-l2-overlays.js",
    "sync:wiki-catalog-features": "node scripts/sync-wiki-catalog-features.js",
    "sync:wiki-care-common-issues": "node scripts/sync-wiki-care-common-issues.js",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "build:rn": "taro build --type rn",
    "build:qq": "taro build --type qq",
    "build:quickapp": "taro build --type quickapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "dev:rn": "npm run build:rn -- --watch",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:quickapp": "npm run build:quickapp -- --watch"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babel/runtime": "^7.7.7",
    "@nutui/nutui-taro": "^4.2.8",
    "@tarojs/components": "4.2.0",
    "@tarojs/helper": "4.2.0",
    "@tarojs/plugin-framework-vue3": "4.2.0",
    "@tarojs/plugin-html": "4.2.0",
    "@tarojs/plugin-platform-alipay": "4.2.0",
    "@tarojs/plugin-platform-h5": "4.2.0",
    "@tarojs/plugin-platform-jd": "4.2.0",
    "@tarojs/plugin-platform-qq": "4.2.0",
    "@tarojs/plugin-platform-swan": "4.2.0",
    "@tarojs/plugin-platform-tt": "4.2.0",
    "@tarojs/plugin-platform-weapp": "4.2.0",
    "@tarojs/runtime": "4.2.0",
    "@tarojs/shared": "4.2.0",
    "@tarojs/taro": "4.2.0",
    "pinia": "^2.3.1",
    "vue": "^3.3.0",
    "weapp-qrcode": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.8.0",
    "@nutui/auto-import-resolver": "^1.0.0",
    "@tarojs/cli": "4.2.0",
    "@tarojs/taro-loader": "4.2.0",
    "@tarojs/webpack5-runner": "4.2.0",
    "@types/webpack-env": "^1.13.6",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "@vue/babel-plugin-jsx": "^1.0.6",
    "@vue/compiler-sfc": "^3.0.0",
    "babel-preset-taro": "4.2.0",
    "css-loader": "3.4.2",
    "eslint": "^8.12.0",
    "eslint-config-taro": "4.2.0",
    "eslint-plugin-vue": "^8.0.0",
    "less": "^4.1.3",
    "postcss": "^8.4.18",
    "style-loader": "1.3.0",
    "stylelint": "^14.4.0",
    "tsconfig-paths-webpack-plugin": "^4.0.1",
    "typescript": "^5.1.0",
    "unplugin-vue-components": "^0.26.0",
    "vue-loader": "^17.0.0",
    "webpack": "5.78.0"
  }
}
